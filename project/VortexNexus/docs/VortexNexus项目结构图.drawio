        <mxCell id="Pt8oI033ulvRvAzNvY5K-136" value="&lt;div style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; line-height: 22px; white-space: pre; color: rgb(59, 59, 59);&quot;&gt;&lt;div style=&quot;color: rgb(59, 59, 59);&quot;&gt;&lt;span style=&quot;color: rgb(0, 128, 0);&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;// 启动非活跃销毁, 并定义时长, 添加任务 &lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent; color: rgb(0, 16, 128);&quot;&gt;_server&lt;/span&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent; color: rgb(121, 94, 38);&quot;&gt;EnableInactiveRelease&lt;/span&gt;&lt;span style=&quot;font-size: 11px; background-color: transparent;&quot;&gt;(timeout);&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(0, 128, 0); font-size: 11px; background-color: transparent;&quot;&gt;// 设置连接到来的用户端回调函数和请求到来的用户端回调函数&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(59, 59, 59);&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;color: #001080;&quot;&gt;_server&lt;/span&gt;.&lt;span style=&quot;color: #795e26;&quot;&gt;SetConnectedCallback&lt;/span&gt;(&lt;span style=&quot;color: #267f99;&quot;&gt;std&lt;/span&gt;::&lt;span style=&quot;color: #795e26;&quot;&gt;bind&lt;/span&gt;(&lt;span style=&quot;color: #000000;&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color: #267f99;&quot;&gt;HttpServer&lt;/span&gt;::OnConnected, &lt;span style=&quot;color: #0000ff;&quot;&gt;this&lt;/span&gt;, &lt;span style=&quot;color: #267f99;&quot;&gt;std&lt;/span&gt;::&lt;span style=&quot;color: #267f99;&quot;&gt;placeholders&lt;/span&gt;::_1));&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(59, 59, 59);&quot;&gt;&lt;span&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 16, 128);&quot;&gt;_server&lt;/span&gt;.&lt;span style=&quot;color: rgb(121, 94, 38);&quot;&gt;SetMessageCallback&lt;/span&gt;(&lt;span style=&quot;color: rgb(38, 127, 153);&quot;&gt;std&lt;/span&gt;::&lt;span style=&quot;color: rgb(121, 94, 38);&quot;&gt;bind&lt;/span&gt;(&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color: rgb(38, 127, 153);&quot;&gt;HttpServer&lt;/span&gt;::OnMessage, &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;this&lt;/span&gt;, &lt;span style=&quot;color: rgb(38, 127, 153);&quot;&gt;std&lt;/span&gt;::&lt;span style=&quot;color: rgb(38, 127, 153);&quot;&gt;placeholders&lt;/span&gt;::_1, &lt;span style=&quot;color: rgb(38, 127, 153);&quot;&gt;std&lt;/span&gt;::&lt;span style=&quot;color: rgb(38, 127, 153);&quot;&gt;placeholders&lt;/span&gt;::_2));&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
